# Copy to .env and fill in your key. Never commit .env - it is gitignored.

# --- Mode --------------------------------------------------------------------
# local = development: models on your CPU, vectors in a folder, PDFs in data/. Costs nothing.
# cloud = production: Pinecone for vectors + embeddings + re-ranking, Cloudinary for PDFs,
#         MongoDB Atlas for accounts. This is what a Vercel deployment runs.
# Individual settings below still win over the mode default, so you can mix.
RAG_MODE=local

# --- LLM (Groq) --------------------------------------------------------------
# Get a free key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Groq deprecates models fairly often - check console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=800

# --- Embeddings (local, free) ------------------------------------------------
# bge-small-en-v1.5 has a 512-token window, so ~300-word chunks fit without being
# silently truncated. all-MiniLM-L6-v2 only reads 256 tokens - if you switch back to it,
# also drop CHUNK_SIZE_WORDS to ~180 and clear EMBEDDING_QUERY_PREFIX.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# bge/e5 models want an instruction prefix on the query side only. Leave empty for MiniLM.
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages:
EMBEDDING_BATCH_SIZE=64

# Who produces the vectors: local | pinecone | cohere | jina. Blank follows RAG_MODE
# (local -> local, cloud -> pinecone).
EMBEDDINGS_PROVIDER=
# Cohere's trial key is free and needs no card. https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-english-v3.0
COHERE_EMBED_BATCH=96
# Alternative free tier. https://jina.ai/embeddings
JINA_API_KEY=
JINA_EMBED_MODEL=jina-embeddings-v3
JINA_EMBED_BATCH=64
# With an API provider there is no local tokenizer, so chunk length is estimated from
# characters before splitting. Lower CHARS_PER_TOKEN = more conservative = smaller chunks.
API_EMBED_TOKEN_LIMIT=512
CHARS_PER_TOKEN=3.6
PROVIDER_TIMEOUT_SECONDS=60
PROVIDER_MAX_RETRIES=3

# --- Storage -----------------------------------------------------------------
# Relative paths resolve against the project root, not your current directory.
DATA_DIR=data
CHROMA_DIR=storage/chroma_db
CHROMA_COLLECTION=rag_documents

# Which store holds the vectors: chroma | pinecone. Blank follows RAG_MODE.
# The two are not interchangeable for the same data - switching means re-indexing.
VECTOR_STORE=

# Optional: run the development stack against a hosted Chroma instead of a folder.
CHROMA_BACKEND=disk
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# --- Pinecone (production) ----------------------------------------------------
# One vendor for vectors, embeddings and re-ranking. Free Starter plan, no card:
# 2GB storage, 5M embedding tokens/month, 500 rerank requests/month.
# Key: https://app.pinecone.io
PINECONE_API_KEY=
PINECONE_INDEX=rag-documents
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# An index's dimension is fixed when it is created. Change the model and you must change
# the dimension AND recreate the index, or every upsert is rejected.
PINECONE_EMBED_MODEL=llama-text-embed-v2
PINECONE_EMBED_DIM=1024
PINECONE_RERANK_MODEL=bge-reranker-v2-m3
PINECONE_UPSERT_BATCH=100
PINECONE_EMBED_BATCH=96
# Never leave this blank in production: an unset version header defaults to the OLDEST
# supported API version, which is retired eventually and takes the app with it.
PINECONE_API_VERSION=2025-10
CHROMA_ADD_BATCH=1000

# --- Chunking ----------------------------------------------------------------
CHUNK_SIZE_WORDS=300
CHUNK_OVERLAP_WORDS=50

# OCR fallback for scanned/image-only PDFs. Also needs: pip install pytesseract pillow,
# plus the Tesseract binary on PATH. Off by default; when off, such PDFs are skipped.
OCR_ENABLED=false
OCR_DPI=200
OCR_LANG=eng

# --- Retrieval ---------------------------------------------------------------
TOP_K=4
MAX_TOP_K=20
MAX_CONTEXT_CHARS=24000

# Wide candidate set fetched before re-ranking narrows it to TOP_K.
RETRIEVAL_CANDIDATES=30

# Hybrid search: BM25 keyword ranking fused with vector ranking via Reciprocal Rank Fusion.
# Dense vectors handle paraphrase; BM25 handles exact terms ("A* search"). RRF_K=60 is the
# published default damping constant.
HYBRID_ENABLED=true
RRF_K=60

# Cross-encoder re-ranking - the biggest single quality lever. Set false to A/B it with
# `python eval/run_eval.py --no-rerank`.
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Raw cross-encoder logits (unbounded). Nothing above this floor => answer "not in these
# documents" without calling the LLM. Raise it to be stricter, lower it to be permissive.
MIN_RERANK_SCORE=-6.0
# local | pinecone | cohere. Blank follows RAG_MODE.
RERANKER_PROVIDER=
COHERE_RERANK_MODEL=rerank-english-v3.0
# Cohere Rerank scores 0..1, not logits, so it needs its own floor. Do not reuse -6.0 here:
# on a 0..1 scale that keeps every candidate and disables the "not in these documents" answer.
MIN_RERANK_SCORE_API=0.02
# Fallback floor used only when re-ranking is disabled (cosine similarity, 0..1).
MIN_SIMILARITY=0.15

# Pull this many chunks either side of each hit, so the model sees continuous prose.
NEIGHBOR_EXPANSION=1

# --- Conversation ------------------------------------------------------------
# How many previous question/answer pairs to carry into the prompt.
HISTORY_TURNS=4
# Rewrite follow-ups ("what about the second one?") into standalone questions before
# retrieving. Costs one small extra Groq call per follow-up.
REWRITE_FOLLOWUPS=true

# --- Misc --------------------------------------------------------------------
LOG_LEVEL=INFO

# Largest PDF accepted by the browser upload box, in megabytes.
MAX_UPLOAD_MB=100

# --- Authentication ---
# Local MongoDB holding user accounts. Documents and vectors do NOT live here.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=rag_app
# Leave JWT_SECRET blank: one is generated and appended here on first run. Changing it
# signs everyone out.
JWT_SECRET=
JWT_EXPIRE_HOURS=12
