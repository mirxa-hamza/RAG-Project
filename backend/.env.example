# Get a free key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model used to generate answers (check console.groq.com/docs/models for the current list —
# Groq deprecates old models fairly often)
GROQ_MODEL=openai/gpt-oss-20b

# Local embedding model (downloaded once from HuggingFace, then cached)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Where ChromaDB stores its data on disk
CHROMA_DIR=./chroma_db
CHROMA_COLLECTION=rag_documents

# Chunking
CHUNK_SIZE_WORDS=300
CHUNK_OVERLAP_WORDS=50

# How many chunks to retrieve per question
TOP_K=4
