# Copy to .env and fill in your keys. Never commit .env - it is gitignored.
# Everything below has a working default in src/core/config.py - only "REQUIRED" needs to
# be set to run at all; the rest is there to tune behavior if you want to.

# ===== Mode ============================================================================
# local = dev: models on your CPU, vectors in a folder, PDFs in data/, state in memory.
# cloud = production (Vercel): Pinecone embeddings/rerank, Chroma Cloud or Pinecone vectors,
#         Cloudinary for PDFs, MongoDB for everything else. Any setting below can still
#         override its RAG_MODE default - see CLAUDE.md's "Cloud mode" section.
RAG_MODE=local

# ===== Required - both modes ============================================================
GROQ_API_KEY=your_groq_api_key_here    # https://console.groq.com/keys
MONGO_URI=mongodb://localhost:27017    # accounts; use an Atlas URI in cloud mode
MONGO_DB=rag_app
JWT_SECRET=                            # local: auto-generated on first run. cloud: set it yourself (64 hex chars)

# ===== Required - cloud mode only =======================================================
PINECONE_API_KEY=                      # embeddings + re-ranking - required even if vectors go to Chroma Cloud below

# Vectors - pick ONE. (a) Pinecone: nothing else to set. (b) Chroma Cloud: uncomment these 5.
# VECTOR_STORE=chroma
# CHROMA_BACKEND=cloud
# CHROMA_API_KEY=
# CHROMA_TENANT=
# CHROMA_DATABASE=

CLOUDINARY_CLOUD_NAME=                 # PDF storage - https://cloudinary.com dashboard
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Optional - local mode =============================================================
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5           # 512-token window; switching models needs a re-index
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages:
DATA_DIR=data                                    # relative paths resolve against the project root
CHROMA_DIR=storage/chroma_db
CHROMA_COLLECTION=rag_documents

# ===== Optional - cloud mode ==============================================================
PINECONE_INDEX=rag-documents
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBED_MODEL=llama-text-embed-v2         # index dimension is fixed at creation - keep PINECONE_EMBED_DIM in sync
PINECONE_EMBED_DIM=1024
PINECONE_RERANK_MODEL=bge-reranker-v2-m3
PINECONE_API_VERSION=2025-10                     # never leave blank in production
CLOUDINARY_FOLDER=rag-documents
# Chunks one POST /ingest/continue may embed before returning. Bounded so a large PDF
# finishes across several requests instead of hitting Vercel's maxDuration and retrying
# from scratch forever. Raise it alongside maxDuration in vercel.json.
INGEST_CHUNKS_PER_REQUEST=400

# Keyword (BM25) half of hybrid retrieval: auto | on | off. "auto" runs it only when the
# vectors are on local disk - against a hosted store it would download the whole corpus to
# build the index, which on a free tier takes minutes and can drop the connection.
KEYWORD_SEARCH=auto

# ===== Optional - retrieval & chunking (both modes) =======================================
TOP_K=4
RETRIEVAL_CANDIDATES=30                          # candidates fetched before re-ranking narrows to TOP_K
HYBRID_ENABLED=true                              # BM25 + vector search, fused via RRF
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MIN_RERANK_SCORE=-6.0                            # raw logits; below this = "not in these documents"
MIN_SIMILARITY=0.15                              # fallback floor when re-ranking is off
NEIGHBOR_EXPANSION=1
MAX_CONTEXT_CHARS=24000
CHUNK_SIZE_WORDS=300
CHUNK_OVERLAP_WORDS=50

# ===== Optional - OCR (scanned PDFs; needs `pip install pytesseract pillow` + Tesseract) ===
OCR_ENABLED=false

# ===== Optional - conversation & caching ===================================================
HISTORY_TURNS=4
REWRITE_FOLLOWUPS=true                           # rewrite follow-ups into standalone questions before retrieving
ANSWER_CACHE_ENABLED=true

# ===== Optional - limits & misc =============================================================
MAX_UPLOAD_MB=100
MAX_USER_STORAGE_MB=2048
GROQ_MODEL=openai/gpt-oss-20b
JWT_EXPIRE_HOURS=12
LOG_LEVEL=INFO
