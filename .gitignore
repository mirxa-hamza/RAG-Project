# ─── Secrets ────────────────────────────────────────────────────────────────
# Never commit real API keys. .env.example IS tracked and is the template.
.env
.env.*
!.env.example

# ─── Python ─────────────────────────────────────────────────────────────────
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Generated index state ──────────────────────────────────────────────────
# The vector store is DERIVED data: it is rebuilt from data/ by scripts/ingest.py.
# It is large, binary, unmergeable, and only valid for the exact embedding model and
# chunk settings that produced it — so it must never be committed. Each collaborator
# builds their own.
storage/

# ─── Source documents ───────────────────────────────────────────────────────
# The PDFs themselves stay out of the repo: they are large, often copyrighted, and
# change independently of the code. Share them out of band (Drive, USB, S3).
# data/.gitkeep is tracked so the folder exists after a fresh clone.
data/*
!data/.gitkeep

# ─── Test & evaluation artifacts ────────────────────────────────────────────
tests/fixtures/
eval/runs/

# ─── Reference material kept locally for study, not part of this project ────
refrence/

# ─── Logs & OS / editor junk ────────────────────────────────────────────────
*.log
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Local backups produced by scripts/backup.py - user data, never in git.
backups/
# Draft eval questions awaiting human review.
eval/golden_draft.json
