# Secrets — never commit real API keys
backend/.env

# Python
backend/venv/
backend/__pycache__/
**/__pycache__/
*.pyc

# ChromaDB local persistence (rebuilt by ingesting the data/ folder)
backend/chroma_db/

# data/ is the live ingestion source (real PDFs, possibly copyrighted/large) - never commit
# the documents themselves, only the code that processes them.
data/*.pdf

# Generated test fixtures (backend/make_test_pdf.py writes here, never into data/)
backend/test_fixtures/

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/
