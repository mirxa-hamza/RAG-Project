# Secrets — never commit real API keys
.env

# Python
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Generated index state (rebuilt from data/ by scripts/ingest.py)
storage/

# data/ is the live ingestion source (real PDFs, possibly large/copyrighted) — never
# commit the documents themselves, only the code that processes them.
data/*.pdf
data/**/*.pdf

# Generated test fixtures (scripts/make_test_pdf.py writes here, never into data/)
tests/fixtures/

# Evaluation run outputs
eval/runs/

# Reference material kept locally for study, not part of this project
refrence/

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/

# Legacy pre-restructure index location (stale, safe to delete)
backend/
